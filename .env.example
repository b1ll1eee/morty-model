# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ
# โมเดลที่ใช้ (ดูรายการที่มีด้วย: ollama list)
MORTY_MODEL=qwen2.5:7b
# MORTY_MODEL=qwen3:14b

# ที่อยู่ Ollama server (ค่าเริ่มต้นคือเครื่องตัวเอง)
OLLAMA_HOST=http://127.0.0.1:11434

# system prompt เริ่มต้นของผู้ช่วย
MORTY_SYSTEM_PROMPT=คุณคือ Morty ผู้ช่วย AI ที่ตอบเป็นภาษาไทยอย่างกระชับและถูกต้อง

# profile เริ่มต้น: general (ผู้ช่วยทั่วไป) หรือ dev (expert สายพัฒนาซอฟต์แวร์)
MORTY_PROFILE=general

# ที่เก็บไฟล์โมเดลของ Ollama (ตัวแปรนี้ Ollama server อ่านเอง ไม่ใช่โค้ด Python)
# ตั้งไว้ใน ~/.zshrc แล้ว ถ้าเปิด server เองให้รัน: OLLAMA_MODELS=/Volumes/DEV/models/ollama ollama serve
# OLLAMA_MODELS=/Volumes/DEV/models/ollama

# บันทึกการใช้งานจริงลง logs/ (ไม่ commit) เพื่อนำกลับมาเป็น eval ตั้งเป็น 0 เพื่อปิด
MORTY_LOG=1
